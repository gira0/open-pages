{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "open-pages chart values",
  "type": "object",
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {
          "type": "string"
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "replicaCount": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "Exactly 1: SQLite on a ReadWriteOnce volume supports one writer."
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "appHost": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*$"
        },
        "contentDomain": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*$"
        },
        "httpPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "cookieSecure": {
          "type": "boolean"
        },
        "trustedProxies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "corsOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "drainDelay": {
          "type": "integer",
          "minimum": 0
        },
        "shutdownTimeout": {
          "type": "integer",
          "minimum": 1
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxUploadMb": {
              "type": "integer",
              "minimum": 0
            },
            "maxExtractMb": {
              "type": "integer",
              "minimum": 0
            },
            "maxExtractFiles": {
              "type": "integer",
              "minimum": 0
            },
            "maxConcurrentDeploys": {
              "type": "integer",
              "minimum": 0
            },
            "deployTimeoutSeconds": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "sites": {
          "type": "object",
          "properties": {
            "keepVersions": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "quotas": {
          "type": "object",
          "properties": {
            "siteMb": {
              "type": "integer",
              "minimum": 0
            },
            "userMb": {
              "type": "integer",
              "minimum": 0
            },
            "sitesPerUser": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "audit": {
          "type": "object",
          "properties": {
            "retentionDays": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "auth": {
          "type": "object",
          "properties": {
            "localLogin": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "log": {
          "type": "object",
          "properties": {
            "level": {
              "enum": [
                "debug",
                "info",
                "warn",
                "error"
              ]
            },
            "format": {
              "enum": [
                "text",
                "json"
              ]
            }
          },
          "additionalProperties": false
        },
        "metrics": {
          "type": "object",
          "properties": {
            "listen": {
              "type": "string",
              "pattern": "^$|^[^:]*:[0-9]{1,5}$"
            },
            "tokenFromSecret": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "oidc": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "issuer": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "redirectUrl": {
              "type": "string"
            },
            "scopes": {
              "type": "string"
            },
            "emailClaim": {
              "type": "string"
            },
            "groupsClaim": {
              "type": "string"
            },
            "allowedEmailDomain": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "saml": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "idpMetadataUrl": {
              "type": "string"
            },
            "entityId": {
              "type": "string"
            },
            "acsUrl": {
              "type": "string"
            },
            "emailAttribute": {
              "type": "string"
            },
            "groupsAttribute": {
              "type": "string"
            },
            "nameidAttribute": {
              "type": "string"
            },
            "allowedEmailDomain": {
              "type": "string"
            },
            "signRequests": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "defaultMode": {
          "type": "integer",
          "minimum": 0
        },
        "keys": {
          "type": "object",
          "properties": {
            "oidcClientSecret": {
              "type": "string",
              "minLength": 1
            },
            "metricsToken": {
              "type": "string",
              "minLength": 1
            },
            "samlKey": {
              "type": "string",
              "minLength": 1
            },
            "samlCert": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "oidcClientSecret": {
          "type": "string"
        },
        "metricsToken": {
          "type": "string"
        },
        "samlKey": {
          "type": "string"
        },
        "samlCert": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadWriteOncePod",
              "ReadOnlyMany",
              "ReadWriteMany"
            ]
          }
        },
        "size": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "stagingVolume": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sizeLimit": {
          "type": "string"
        },
        "medium": {
          "enum": [
            "",
            "Memory"
          ]
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "metricsService": {
      "type": "object",
      "properties": {
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "fsGroup": {
          "type": [
            "integer",
            "null"
          ]
        },
        "runAsNonRoot": {
          "type": "boolean"
        }
      }
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "probes": {
      "type": "object",
      "properties": {
        "liveness": {
          "type": "object",
          "properties": {
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "readiness": {
          "type": "object",
          "properties": {
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "startup": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "tls": {
          "type": "object",
          "properties": {
            "appSecretName": {
              "type": "string"
            },
            "wildcardSecretName": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "timeout": {
          "type": "string",
          "pattern": "^[0-9]+(us|ms|s|m|h|d)$"
        },
        "annotations": {
          "type": "object"
        },
        "tls": {
          "type": "object",
          "properties": {
            "insecureEdgeTerminationPolicy": {
              "enum": [
                "Allow",
                "Disable",
                "Redirect"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        },
        "scrapeTimeout": {
          "type": "string"
        },
        "labels": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "appIngressFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "metricsIngressFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egress": {
          "type": "object",
          "properties": {
            "dnsTo": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "allowedCIDRs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowedPorts": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "extraRules": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
